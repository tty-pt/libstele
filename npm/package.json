{
  "name": "@tty-pt/stele",
  "version": "1.5.0",
  "type": "module",
  "description": "Universal Node.js and Browser bindings for libstele system substrate and isomorphic C runtime contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "include",
    "assets",
    "*.pc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "mkdir -p build/Release && gcc -O3 -fPIC -shared -I/usr/include/node -I../include -I/usr/include native/stele_napi.c -L../lib -Wl,-rpath,../lib -L/usr/lib -lstele -o build/Release/stele_node.node 2>/dev/null || true",
    "build:wasm": "clang --target=wasm32-wasi -mexec-model=reactor -Wl,--no-entry -Wl,--allow-undefined -Wl,--export=malloc -Wl,--export=free -Wl,--export=stl_kernel_boot -Wl,--export=stl_kernel_mount -Wl,--export=stl_kernel_unmount -Wl,--export=stl_kernel_update -Wl,--export=stl_kernel_action -Wl,--export=stl_kernel_tick -Wl,--export=stl_kernel_version -Wl,--export=stele_kernel_boot -Wl,--export=stele_kernel_mount -Wl,--export=stele_kernel_unmount -Wl,--export=stele_kernel_update -Wl,--export=stele_kernel_action -Wl,--export=stele_kernel_tick -Wl,--export=stele_kernel_version -I../include -O3 -o dist/stele.wasm ../src/stele_wasm_kernel.c 2>/dev/null || true",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test tests/stele.test.mjs"
  },
  "keywords": [
    "stele",
    "stl",
    "libstele",
    "substrate",
    "isomorphic",
    "iso",
    "system",
    "napi",
    "wasm"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/libstele.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tty-pt/libstele/tree/main/npm#readme",
  "bugs": {
    "url": "https://github.com/tty-pt/libstele/issues"
  }
}
